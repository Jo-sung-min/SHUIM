# Claude API 키 (https://console.anthropic.com 에서 발급)
# 비워두면 AI 대신 간단한 규칙 기반 요약으로 동작합니다.
ANTHROPIC_API_KEY=

# 사용할 모델 (선택)
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- 피드 사진 업로드 (AWS S3 + CloudFront CDN) ----------
# 비우면 사진 업로드 버튼이 숨겨지고, 이미지 주소 입력과 기본 그림만 쓸 수 있어요.
# IAM 사용자에 s3:PutObject, s3:DeleteObject 권한 (해당 버킷/prefix 한정) 필요
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# 버킷 안의 폴더 (선택, 기본 feed)
S3_PREFIX=feed
# CloudFront 배포 도메인 (선택). 있으면 글에 저장되는 이미지 주소가 이 도메인으로 만들어져요.
CDN_BASE_URL=https://xxxxxxxxxx.cloudfront.net

# ---------- PostgreSQL ----------
# jdbc:postgresql://host:5432/db?user=..&password=..  또는  postgresql://user:pass@host:5432/db
DB_URL=

# 개발 모드 샘플 유저 자동 답글 끄기: 0
# COMMUNITY_SIMULATE=0
