# Copy to keystore.properties (git-ignored). Keep the real key outside this repository.
# Use forward slashes in Windows paths. Do not include quote characters around values.
storeFile=C\:/Users/YOUR_NAME/sorow-keys/sorow-upload.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyAlias=sorow-upload
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD

