# ---------- PostgreSQL ----------
# jdbc:postgresql://host:6543/db?user=..&password=..  또는  postgresql://user:pass@host:6543/db
# Supabase 는 6543(트랜잭션 모드) 권장. 5432(세션 모드)는 동시 접속 15개 한도.
# *.pooler.supabase.com 이면 5432 를 자동으로 6543 으로 바꾸고 prepareThreshold=0 을 붙인다.
DB_URL=
# 풀 크기 (선택, 기본 3)
# DB_POOL_MAX=3
# 세션 모드(5432)를 꼭 써야 하면 true
# DB_KEEP_SESSION_MODE=false

# ---------- Claude API ----------
# https://console.anthropic.com 에서 발급. 비워두면 AI 대신 규칙 기반 요약으로 동작.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- 피드 사진 업로드 (AWS S3 + CloudFront CDN) ----------
# 비어 있어도 사진 선택·편집은 열리지만 실제 게시/저장 시 사진 첨부가 실패합니다.
# 사진 기능을 운영하려면 아래 저장소 설정과 허용 출처를 연결하세요.
# Elastic Beanstalk/EC2에서는 인스턴스 IAM 역할 사용 가능: 아래 자격증명 세 칸을 모두 비워 둡니다.
# IAM 역할/사용자에 s3:PutObject, s3:DeleteObject 권한 (sorow-aws-s3/upload/* 한정) 필요
# 정적 키는 ID/SECRET 둘 다 설정하고, 임시 키(STS)는 SESSION_TOKEN도 함께 설정합니다.
# 자세한 설정: backend/S3_SETUP.md. 실제 키는 이 예시 파일에 저장하지 않습니다.
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# ARN이 아닌 버킷 이름. AWS_REGION은 이 버킷의 실제 리전과 같아야 합니다.
S3_BUCKET=sorow-aws-s3
S3_PREFIX=upload
# 버킷 루트를 제공하는 CDN 주소. /upload 또는 정적 에셋 경로는 붙이지 않습니다.
CDN_BASE_URL=https://cdn.sorow.co.kr

# ---------- 카카오 로그인 ----------
# Kakao Developers(https://developers.kakao.com) › 내 애플리케이션 › 앱 키 › REST API 키. 비우면 카카오 로그인이 꺼지고 버튼이 숨겨진다.
KAKAO_CLIENT_ID=
# 카카오 로그인 › 보안 › Client Secret 을 "사용함"으로 켠 경우에만
KAKAO_CLIENT_SECRET=
# Redirect URI 는 APP_ORIGIN + /api/auth/kakao/callback 으로 만들어진다 (개발: http://localhost:3000/api/auth/kakao/callback).
# 콘솔의 카카오 로그인 › Redirect URI 에 똑같이 등록하고, 플랫폼 › Web 사이트 도메인에 APP_ORIGIN 을 넣는다.

# ---------- 서버 ----------
SERVER_PORT=8080
APP_ORIGIN=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
# HTTPS 에서만 true (세션 쿠키 Secure)
AUTH_SECURE_COOKIE=false
AUTH_SESSION_DAYS=90
# 개발용 샘플 유저 자동 답글 (운영: false)
COMMUNITY_SIMULATE=true

# ---------- 커뮤니티 소로우 소속 인증 메일 (SMTP) ----------
# 학교·회사 소로우 멤버 인증 코드를 보낸다. 비우면 메일을 보내지 않는다 (개발 환경에서는 코드를 화면에 표시).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@sorow.co.kr

# ---------- 불씨팝 결제 (설정이 없으면 구매 꺼짐) ----------
# 새 주문·웹 승인 중지. 기존 결제 조회·복구·환불 반영은 유지한다.
PAYMENT_SALES_ENABLED=false
# API 개별 연동 키: test_ck_/test_sk_ 또는 live_ck_/live_sk_ 같은 환경의 한 쌍
TOSS_PAYMENTS_CLIENT_KEY=
TOSS_PAYMENTS_SECRET_KEY=
# 앱인토스 로그인과 IAP에 공통 사용: PEM 파일 경로 또는 PEM 내용
TOSS_MTLS_CERT=
TOSS_MTLS_KEY=
# 각기 다른 소비성 상품 SKU. 콘솔의 최종 가격을 모두 1,000원으로 설정
AIT_IAP_ROSE_SKU=
AIT_IAP_AURORA_SKU=
AIT_IAP_OCEAN_SKU=
AIT_IAP_VIOLET_SKU=
# 기본 1분 주기, 같은 영수증은 최소 5분 간격으로 재조회
PAYMENT_RECONCILE_DELAY_MS=60000
