# env (API 키, DB 비밀번호 등 비밀값) — 어느 폴더에 있어도 올리지 않음
.env
.env.local
.env.*.local

# frontend (Next.js)
node_modules/
.npm-cache/
.pnp
.pnp.js
.next/
out/
# 앱인토스 미니앱 빌드 (npm run build:ait)
out-ait/
.ait-stash/
*.ait
.env.ait
next-env.d.ts
*.tsbuildinfo
.vercel
# Public media lives in S3/CDN; keep source binaries out of Git.
frontend/public/**/*.png
frontend/public/**/*.jpg
frontend/public/**/*.jpeg
frontend/public/**/*.webp
frontend/public/**/*.mp3
frontend/public/**/*.svg
frontend/public/**/*.gif
frontend/public/**/*.avif
frontend/public/**/*.ico
frontend/public/**/*.glb
# 컴포넌트 옆에 import 하는 그림도 CDN 으로 (docs/CDN_ASSETS.md). 번들에 넣지 않고 assetUrl() 로 읽는다.
frontend/components/**/*.png
frontend/components/**/*.jpg
frontend/components/**/*.jpeg
frontend/components/**/*.webp
frontend/components/**/*.gif
frontend/components/**/*.avif

# backend (Spring Boot / Gradle)
.gradle/
backend/build/
backend/bin/
backend/out/
*.class

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local verification files and temporary caches
/.tmp/
/tmp/
/temp/
*.tmp

# editor / os
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
/.tmp-character-reference/

# claude desktop local launch config
.claude/

# Generated map artwork is kept in Git at the user's request.
!frontend/public/garden/art/*.webp
!frontend/public/cloudspa/art/*.webp
# 명화 큐레이션 피드(CDN feed/curation/ 에 올릴 원본, 사용자 요청으로 Git 에도 보관)
!frontend/public/feed/curation/*.webp
# V39 명화(미술관 원본을 줄인 것)는 CDN 에만 둔다 (V50)
frontend/public/feed/curation/met-*.webp
