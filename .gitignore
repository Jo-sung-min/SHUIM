# env (API 키, DB 비밀번호 등 비밀값) — 어느 폴더에 있어도 올리지 않음
.env
.env.local
.env.*.local

# frontend (Next.js)
node_modules/
.npm-cache/
.pnp
.pnp.js
.next/
out/
# 앱인토스 미니앱 빌드 (npm run build:ait)
out-ait/
.ait-stash/
*.ait
.env.ait
next-env.d.ts
*.tsbuildinfo
.vercel
# Public media lives in S3/CDN; keep source binaries out of Git.
frontend/public/**/*.png
frontend/public/**/*.jpg
frontend/public/**/*.jpeg
frontend/public/**/*.webp
frontend/public/**/*.mp3
frontend/public/**/*.svg
frontend/public/**/*.gif
frontend/public/**/*.avif
frontend/public/**/*.ico
frontend/public/**/*.glb

# backend (Spring Boot / Gradle)
.gradle/
backend/build/
backend/bin/
backend/out/
*.class

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# editor / os
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# claude desktop local launch config
.claude/

# Generated map artwork is kept in Git at the user's request.
!frontend/public/garden/art/*.webp
!frontend/public/cloudspa/art/*.webp
