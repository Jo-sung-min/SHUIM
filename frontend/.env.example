# Spring 백엔드 주소. /api/* 요청을 이쪽으로 프록시한다 (기본 http://localhost:8080)
# Vercel 등 운영에서는 배포된 백엔드 주소로 바꾼다.
BACKEND_ORIGIN=http://localhost:8080

# 앱 이미지·바닷가 텍스처·3D 모델. 미설정 시에도 아래 CDN을 기본 사용.
# Vercel에서 추가/변경한 뒤 재배포해야 브라우저에 반영됩니다.
# AWS 액세스 키는 여기에 넣지 않습니다.
NEXT_PUBLIC_ASSET_BASE_URL=https://cdn.sorow.co.kr

# Android app association: Play Console > App integrity > App signing key SHA-256.
# Multiple colon-separated fingerprints may be comma-separated. Do not put private keys here.
ANDROID_PACKAGE_NAME=kr.co.sorow.app
ANDROID_SHA256_FINGERPRINTS=
NEXT_PUBLIC_SITE_URL=https://sorow.co.kr

LEGAL_OPERATOR_NAME=루체
LEGAL_SUPPORT_EMAIL=developer@lucelab.co.kr
# Set true only after retention, processors/regions, actual support operations and policy text are reviewed.
LEGAL_POLICY_APPROVED=false
LEGAL_EFFECTIVE_DATE=
LEGAL_RETENTION_NOTICE=
LEGAL_PROCESSORS_NOTICE=
